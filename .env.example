# Copy to .env and fill in. Every value below is a PLACEHOLDER. Never commit a real .env.
# The app runs without any of this in preview/demo mode (no Databricks connection).

# --- Databricks connection (authenticate with `databricks auth login`; no token stored here) ---
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_ORG_ID=
DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/YOUR_WAREHOUSE_ID

# --- Unity Catalog layout ---
DBX_CATALOG=demo_catalog
DBX_BRONZE_SCHEMA=bronze
DBX_GOLD_SCHEMA=gold
# Defaults to /Volumes/<catalog>/<bronze schema>
# DBX_VOLUME_ROOT=/Volumes/demo_catalog/bronze

# --- Published dashboards and Genie space (ids from the dashboard / Genie URLs) ---
DASHBOARD_ID_COMMUNITY=YOUR_COMMUNITY_DASHBOARD_ID
DASHBOARD_ID_LEARNINGS=YOUR_LEARNINGS_DASHBOARD_ID
DASHBOARD_ID_EVENTS=YOUR_EVENTS_DASHBOARD_ID
DASHBOARD_ID_TRAININGS=YOUR_TRAININGS_DASHBOARD_ID
DASHBOARD_ID_REVENUE=YOUR_REVENUE_DASHBOARD_ID
GENIE_SPACE_ID=YOUR_GENIE_SPACE_ID
GENIE_SPACE_NAME=Analytics Department Activities

# --- Where finished decks are stored (link shown in the UI) ---
DECKS_URL=https://example.sharepoint.com/sites/your-site/Shared%20Documents
DECKS_LABEL=KPI decks (shared drive)
SCHEDULE_TIMEZONE=UTC

# --- Optional overrides ---
# ORG_PROFILE_PATH=config/org_profile.toml
# DECK_LAYOUT_PATH=config/deck_layout.json
